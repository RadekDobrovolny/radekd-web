<header>
    <div class="xylophone">
        <button data-note="C" class="key" style="--i: 0;" aria-label="Play note C"></button>
        <button data-note="D" class="key" style="--i: 1;" aria-label="Play note D"></button>
        <button data-note="E" class="key" style="--i: 2;" aria-label="Play note E"></button>
        <button data-note="F" class="key" style="--i: 3;" aria-label="Play note F"></button>
        <button data-note="G" class="key" style="--i: 4;" aria-label="Play note G"></button>
        <button data-note="A" class="key" style="--i: 5;" aria-label="Play note A"></button>
        <button data-note="B" class="key" style="--i: 6;" aria-label="Play note B"></button>
        <button data-note="C2" class="key" style="--i: 7;" aria-label="Play note C high"></button>
    </div>
    <div class="menu">
        <nav>
            <ul>
                <li><a href="{{ '/index.html' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a></li>
                <li><a href="{{ '/resume/index.html' | url }}" {% if page.url == '/resume/' %}aria-current="page"{% endif %}>Résumé</a></li>
                <li><a href="{{ '/portfolio/index.html' | url }}" {% if page.url == '/portfolio/' %}aria-current="page"{% endif %}>Portfolio</a></li>
                <li><a href="{{ '/blog/index.html' | url }}" {% if page.url == '/blog/' or (page.url and page.url.indexOf('/post/') == 0) %}aria-current="page"{% endif %}>Blog</a></li>
                <li>
                    <button class="switch" id="switch"><img src="{{ '/assets/images/ice-cream.png' | url }}"
                                                            class="ice-cream" alt="Light mode"><img
                            src="{{ '/assets/images/spruce.png' | url }}" class="spruce" alt="Dark mode"></button>
                </li>
            </ul>
        </nav>
    </div>
</header>