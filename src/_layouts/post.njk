{% include "partials/_head.njk" %}
<body>
{% include "partials/_navigation.njk" %}
<main>
    <div class="main-container">
        <section class="content-row">
            <div class="card resume">
                {% set translation = collections.post | translationOf(translationKey, page.url) %}
                {% if translation %}
                <div class="language-switch">
                    <a href="{{ translation.url | url }}" lang="{{ translation.data.lang }}" class="language-toggle">
                        {% if translation.data.lang == 'en' %}🇺🇸 English (AI){% else %}🇨🇿 Czech (original){% endif %}
                    </a>
                </div>
                {% endif %}
                <p>{{ page.date | postDate(lang) }}</p>
                {{ content | nonBreakingSpaces | breakableLinks | safe }}
            </div>
        </section>
    </div>
</main>
{% include "partials/_footer.njk" %}